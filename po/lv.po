#: src/main.cc:62
#, c-format
msgid ""
"Xfce4 Sensors %s\n"
"Displays information about your hardware sensors, ACPI status, harddisk temperatures and Nvidia GPU's temperature.\n"
"Synopsis: \n"
"  xfce4-sensors [option]\n"
"where [option] is one of the following:\n"
"  -h, --help    Print this help dialog.\n"
"  -l, --license Print license information.\n"
"  -V, --version Print version information.\n"
"\n"
"This program is published under the GPL v2.\n"
msgstr "Xfce4 sensori %s\nRāda informāciju par aparatūras sensoriem, ACPI statusu, cieto disku temperatūrām un Nvidia GPU temperatūru.\nSinopse: \n  xfce4-sensors [opcija]\nkur [opcija] ir viena no šīm:\n  -h, --help    Izdrukāt šo palīdzību.\n  -l, --license Izdrukāt licences informāciju.\n  -V, --version Izdrukāt versijas informāciju.\n\nŠī programma publicēta saskaņā ar GPL v2.\n"

